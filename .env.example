# Sem este arquivo, a página institucional funciona e o dashboard nega acesso.
# Valores aceitos nesta etapa: local ou test. Padrão: local.
APP_ENV=local

# Servidor Next.js: PostgreSQL local 18.6, banco routepay_dev, usuário routepay_app.
# Formato sem senha: postgresql://routepay_app@127.0.0.1:5432/routepay_dev
# Não reutilize bancos/credenciais de outros projetos. Hosts remotos são recusados.
DATABASE_URL=

# Exclusiva do processo CLI de migrations: routepay_migrator no mesmo routepay_dev.
# Formato sem senha: postgresql://routepay_migrator@127.0.0.1:5432/routepay_dev
# Fornecer apenas ao processo CLI; manter vazia na configuração do Next.js.
# A CLI não carrega .env.local e não usa DATABASE_URL como fallback.
MIGRATION_DATABASE_URL=

# Gerar futuramente um segredo próprio de alta entropia, com pelo menos 32 caracteres.
# Exemplo de comando local: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Opcionais até a configuração manual do Google. Preencher ambos ou nenhum.
# Callback local: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nenhuma integração financeira, RPC ou serviço pago é utilizada nesta etapa.
# Nunca adicione chaves privadas ou seed phrases à aplicação.
